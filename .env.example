# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# DagsHub-hosted MLflow tracking server for this project.
MLFLOW_TRACKING_URI=https://dagshub.com/adi-awasthi/food-delivery-time-prediction.mlflow

# DagsHub credentials used to authenticate MLflow tracking calls.
# Generate a token at: https://dagshub.com/user/settings/tokens
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
